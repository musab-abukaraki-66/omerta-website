# Copy to .env for local overrides. Never commit real values; PUBLIC_ variables are
# compiled into client JavaScript, so nothing secret belongs here.

# Production HTTPS origin used for canonical URLs, Open Graph and the sitemap.
# Leave unset for Vercel preview deployments: they use their own URL and are noindex.
SITE_URL=https://www.example.com

# HTTPS endpoint that accepts the contact form's JSON POST (for example a form
# service URL or your own API). Leave empty and the form states that nothing was sent.
PUBLIC_CONTACT_ENDPOINT=
