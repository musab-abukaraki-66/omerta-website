---
import Wordmark from './Wordmark.astro';
import { nav, credits, contentStatus, site, designer } from '../content/site';
const year = new Date().getFullYear();
---

<footer class="site-footer" data-theme="dark" data-section-theme="dark">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <a href="/" class="site-footer__logo" aria-label="OMERTA — home"><Wordmark animated={false} /></a>
      <p class="site-footer__tag">{site.tagline}</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <p class="label site-footer__h">Index</p>
      <ul role="list">
        {nav.map((item) => (
          <li><a class="link" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__credits">
      <p class="label site-footer__h">Imagery</p>
      <ul role="list" class="micro">
        {credits.map((c) => (
          <li>
            <a href={c.href} rel="noopener" target="_blank">{c.what} — {c.source}<span class="sr-only"> (opens in a new tab)</span></a>
          </li>
        ))}
      </ul>
      <p class="micro site-footer__note">
        NASA imagery is used as public-domain reference material and does not imply NASA endorsement.
        Satellite and Earth renders are real-time concept visualisations.
      </p>
    </div>
  </div>

  <div class="wrap site-footer__base micro">
    <p>© {year} OMERTA</p>
    {contentStatus === 'provisional' && (
      <p data-content-status>Service descriptions are provisional and subject to confirmation.</p>
    )}
    {site.privacyNoticeUrl && <a class="link" href={site.privacyNoticeUrl}>Privacy notice</a>}
    <a class="link" href="#top" data-to-top>Back to top</a>
  </div>

  <div class="wrap site-footer__made">
    <p class="label">
      <span class="site-footer__made-k">Created &amp; designed by</span>
      {designer.url ? (
        <a class="site-footer__made-name" href={designer.url} target="_blank" rel="noopener noreferrer">
          <span class="site-footer__made-text">{designer.name}</span>
          <svg class="site-footer__made-icon" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 8 8 2M3.5 2H8v4.5" fill="none" stroke="currentColor" stroke-width="1.2"></path></svg>
          <span class="sr-only"> — LinkedIn profile (opens in a new tab)</span>
        </a>
      ) : (
        <span class="site-footer__made-name">{designer.name}</span>
      )}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    --fg: var(--bone);
    --fg-2: var(--mist);
    background: var(--void);
    color: var(--bone);
    border-top: 1px solid var(--line-dark);
    padding-top: var(--s-5);
  }
  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr 1.4fr;
    gap: var(--s-4);
    padding-bottom: var(--s-5);
  }
  .site-footer__logo {
    display: block;
    width: 180px;
  }
  .site-footer__tag {
    margin-top: 1.25rem;
    color: var(--mist);
  }
  .site-footer__h {
    color: var(--mist);
    margin-bottom: 1.1rem;
  }
  .site-footer__nav li + li {
    margin-top: 0.3rem;
  }
  .site-footer__nav .link {
    display: inline-block;
    padding-block: 4px;
  }
  .site-footer__credits a {
    display: inline-block;
    padding-block: 5px;
  }
  .site-footer__credits a:hover {
    color: var(--bone);
  }
  .site-footer__note {
    margin-top: 1.25rem;
    max-width: 52ch;
  }
  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--line-dark);
  }
  .site-footer__base .link {
    color: var(--bone);
  }
  /* Designer credit: the closing line of the page. */
  .site-footer__made {
    padding-block: 1.75rem 2.25rem;
    border-top: 1px solid var(--line-dark);
    text-align: center;
  }
  .site-footer__made .label {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.35rem 0.9rem;
  }
  .site-footer__made-k {
    color: var(--mist);
  }
  .site-footer__made-name {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-block: 6px;
    color: var(--bone);
  }
  a.site-footer__made-name::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 500ms var(--ease-aperture);
  }
  a.site-footer__made-name:hover::after,
  a.site-footer__made-name:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .site-footer__made-icon {
    width: 0.62em;
    height: 0.62em;
    transition: transform 400ms var(--ease-out), color 300ms var(--ease-std);
  }
  a.site-footer__made-name:hover .site-footer__made-icon,
  a.site-footer__made-name:focus-visible .site-footer__made-icon {
    color: var(--signal);
    transform: translate(2px, -2px);
  }
  @media (max-width: 900px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
