---
import Wordmark from './Wordmark.astro';
import { nav } from '../content/site';
const path = Astro.url.pathname;
---

<header class="site-header" data-header data-theme="dark">
  <div class="site-header__inner">
    <button
      class="hdr-btn hdr-menu"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
    >
      <span class="hdr-menu__icon" aria-hidden="true"><i></i><i></i></span>
      <span class="label hdr-menu__label" data-menu-label>Index</span>
    </button>

    <a class="hdr-logo" href="/" aria-label="OMERTA — home" data-header-logo>
      <Wordmark title="OMERTA" />
    </a>

    <a class="hdr-btn hdr-contact label" href="/contact/" aria-label="Contact" aria-current={path.startsWith('/contact') ? 'page' : undefined}>
      <span class="hdr-contact__text">Contact</span>
      <svg class="hdr-contact__icon" viewBox="0 0 14 10" aria-hidden="true"><path d="M0 5h12M8 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.2"></path></svg>
    </a>
  </div>
</header>

<div class="menu" id="site-menu" data-menu hidden>
  <div class="menu__panel" role="dialog" aria-modal="true" aria-label="Site index">
    <nav class="menu__nav wrap" aria-label="Primary">
      <ol role="list" class="menu__list">
        {
          nav.map((item) => (
            <li class="menu__item">
              <a class="menu__link" href={item.href} data-menu-link>
                <span class="label menu__index">{item.index}</span>
                <span class="menu__text">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="micro menu__foot">OMERTA — Satellite &amp; space systems</p>
    </nav>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    height: var(--header-h);
    color: var(--fg);
    transition: color 500ms var(--ease-std);
    pointer-events: none;
  }
  .site-header__inner {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-inline: var(--gutter);
  }
  .site-header a,
  .site-header button {
    pointer-events: auto;
  }
  .hdr-logo {
    display: block;
    width: 148px;
    padding: 10px 0;
  }
  .hdr-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    font: 500 var(--fs-label) / 1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hdr-menu {
    justify-self: start;
  }
  .hdr-contact {
    justify-self: end;
  }
  .hdr-contact__icon {
    width: 14px;
    height: 10px;
    transition: transform var(--t-micro) var(--ease-out);
  }
  .hdr-contact:hover .hdr-contact__icon {
    transform: translateX(4px);
  }
  .hdr-menu__icon {
    position: relative;
    width: 22px;
    height: 10px;
  }
  .hdr-menu__icon i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.25px;
    background: currentColor;
    transition: transform 400ms var(--ease-out), top 400ms var(--ease-out), width 400ms var(--ease-out);
  }
  .hdr-menu__icon i:first-child {
    top: 0;
  }
  .hdr-menu__icon i:last-child {
    top: 8px;
    width: 60%;
  }
  .hdr-menu:hover .hdr-menu__icon i:last-child {
    width: 100%;
  }
  .hdr-menu[aria-expanded='true'] .hdr-menu__icon i:first-child {
    top: 4px;
    transform: rotate(45deg);
  }
  .hdr-menu[aria-expanded='true'] .hdr-menu__icon i:last-child {
    top: 4px;
    width: 100%;
    transform: rotate(-45deg);
  }
  /* While the menu is open the header sits above it and is always light-on-dark. */
  :global(html.menu-open) .site-header {
    color: var(--bone);
    z-index: calc(var(--z-menu) + 1);
  }

  /* ---- Menu overlay ---- */
  .menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    color: var(--bone);
  }
  .menu[hidden] {
    display: none;
  }
  .menu__panel {
    position: absolute;
    inset: 0;
    background: var(--void);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 700ms var(--ease-aperture);
    overflow-y: auto;
  }
  .menu.is-open .menu__panel {
    clip-path: inset(0 0 0 0);
  }
  .menu__nav {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: 2rem;
  }
  .menu__list {
    border-top: 1px solid var(--line-dark);
  }
  .menu__item {
    border-bottom: 1px solid var(--line-dark);
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 600ms var(--ease-out), transform 600ms var(--ease-out);
  }
  .menu.is-open .menu__item {
    opacity: 1;
    transform: none;
  }
  .menu.is-open .menu__item:nth-child(1) { transition-delay: 180ms; }
  .menu.is-open .menu__item:nth-child(2) { transition-delay: 220ms; }
  .menu.is-open .menu__item:nth-child(3) { transition-delay: 260ms; }
  .menu.is-open .menu__item:nth-child(4) { transition-delay: 300ms; }
  .menu.is-open .menu__item:nth-child(5) { transition-delay: 340ms; }
  .menu.is-open .menu__item:nth-child(6) { transition-delay: 380ms; }
  .menu__link {
    display: flex;
    align-items: baseline;
    gap: clamp(1rem, 4vw, 3rem);
    padding: clamp(0.6rem, 1.6vh, 1.1rem) 0;
    transition: color var(--t-micro) var(--ease-std), padding var(--t-micro) var(--ease-out);
  }
  .menu__index {
    color: var(--mist);
    min-width: 2.5ch;
  }
  .menu__text {
    font-weight: 300;
    font-size: clamp(1.6rem, min(6.4vh, 9vw), 4.25rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .menu__link:hover,
  .menu__link:focus-visible {
    padding-left: 0.75rem;
  }
  .menu__link:hover .menu__index,
  .menu__link:focus-visible .menu__index {
    color: var(--signal);
  }
  .menu__foot {
    margin-top: 2rem;
  }

  @media (max-width: 768px) {
    .hdr-logo {
      width: 112px;
    }
    .hdr-contact__text {
      display: none;
    }
    .hdr-contact {
      min-width: 44px;
      justify-content: flex-end;
    }
    .hdr-contact__icon {
      width: 18px;
      height: 13px;
    }
  }
  @media (max-width: 380px) {
    .hdr-menu__label {
      display: none;
    }
  }
</style>
